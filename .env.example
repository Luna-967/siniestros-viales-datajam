# Copia este archivo como .env y completa los valores reales.
# Nunca publiques .env: contiene la contraseña de PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=siniestros_bogota
PGUSER=postgres
PGPASSWORD=CAMBIA_ESTE_VALOR

# Ruta absoluta o relativa al archivo Excel. El Excel está ignorado por Git.
EXCEL_PATH=C:/ruta/a/siniestros_viales_consolidados_bogota_dc.xlsx
